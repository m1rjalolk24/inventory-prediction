[Unit]
Description=Korzinka Inventory Forecasting API
After=network.target

[Service]
User=azureuser
WorkingDirectory=/home/azureuser/app
Environment="PATH=/home/azureuser/venv/bin"
Environment="DATABASE_URL=sqlite:////home/azureuser/app/korzinka.db"

# 1 worker keeps RAM usage manageable with the 733 MB Random Forest model.
# Timeout 120s covers the first request (~30s feature build from train.csv).
ExecStart=/home/azureuser/venv/bin/gunicorn \
    --workers 1 \
    --timeout 120 \
    --bind 127.0.0.1:5000 \
    --access-logfile - \
    --error-logfile - \
    wsgi:app

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
